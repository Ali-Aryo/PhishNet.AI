# Python virtual environment folder
venv/

# Python compiled files
__pycache__/
*.pyc

# Operating System specific files
.DS_Store # macOS
Thumbs.db # Windows
.vscode/ # VS Code specific files (optional, but good if team uses different IDEs)

# Environment variables (if you had a .env file for secrets)
.env

# Jupyter/Colab specific files that might get created
.ipynb_checkpoints/